# Copy to .env.local (gitignored) and fill in. Never commit real values.

# REQUIRED — the token you generate in Graph API Explorer (ads_read + read_insights)
META_ACCESS_TOKEN=

# OPTIONAL but recommended — lets the script auto-exchange your short-lived token
# for a long-lived (~60-day) one, and sign calls with appsecret_proof.
# From your Meta app: Settings → Basic → App ID + App Secret.
META_APP_ID=
META_APP_SECRET=

# OPTIONAL — pin the ad account (act_XXXXXXXX). If blank, the script discovers
# your accounts and picks the Fast Fund Leads / Lions Pride one (or lists them).
META_AD_ACCOUNT=

# OPTIONAL — Meta Graph API version (default v21.0)
META_API_VERSION=v21.0

# Fast Fund Leads business portfolio (for reference / account discovery)
META_BUSINESS_ID=111197363467699
